{
    "name": "tancky/upscale-calculator",
    "description": "Dependency-free PHP helpers for image upscaling math: scaled dimensions, the smallest upscale factor for a target size, and print sizes at a given DPI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["image", "upscale", "upscaler", "dimensions", "resolution", "dpi", "print", "aspect-ratio"],
    "homepage": "https://tancky.io",
    "authors": [
        {
            "name": "Tancky AI",
            "homepage": "https://tancky.io"
        }
    ],
    "support": {
        "issues": "https://github.com/tancky777/upscale-calculator/issues",
        "source": "https://github.com/tancky777/upscale-calculator"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Tancky\\UpscaleCalculator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tancky\\UpscaleCalculator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
